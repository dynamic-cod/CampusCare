graph TB
    subgraph CLIENT["Client Tier — Browser Requests"]
        A1["🧑‍🎓 Student\n(Anonymous / Token-Auth)"]
        A2["🔧 Maintenance Technician\n(Zero-Login UUID Worker)"]
        A3["🏛️ Hall Provost / Caretaker\n(Building-Scoped Admin)"]
        A4["📋 Maintenance HOD\n(Trade-Scoped Admin)"]
        A5["🎓 Central Registrar\n(Global SuperAdmin Console)"]
        A6["⚙️ System Administrator\n(Django SuperUser)"]
    end

    subgraph ROUTING["Permission & Decorator Layer — core/decorators.py + core/permissions.py"]
        R1["@login_not_required\nPublic complaint routes\nNo session required"]
        R2["@uuid_token_required\nHMAC-validated UUID\nSingle-use task token"]
        R3["@role_required(PROVOST)\n+ building_scope_check()\nManaged building enforced"]
        R4["@role_required(HOD)\n+ department_scope_check()\nManaged department enforced"]
        R5["@role_required(REGISTRAR)\nNo scope restriction\nGlobal read/write"]
        R6["@superuser_required\nDjango is_superuser=True\nFull system access"]
    end

    subgraph VIEWS["View Layer — core/views/ package"]
        V1["public.py\nhome(), campus_directory()\ncomplaint_create()\ntracking_view()\nfeedback_view()"]
        V2["tasks.py\ntechnician_task_view()\naccept_task()\ncomplete_task()"]
        V3["dashboards.py\nprovost_dashboard()\nassign_complaint()"]
        V4["dashboards.py\nhod_dashboard()\nassign_complaint()"]
        V5["dashboards.py\nregistrar_dashboard()\nanalytics_dashboard()\ncomplaint_report_csv()"]
        V6["dashboards.py + admin.py\nAll management views\nUser / role management\nSystem config"]
    end

    subgraph SCOPE["ORM Scope Filter Layer — IDOR Prevention"]
        D1["Complaint.objects.filter(\n  room__floor__building=profile.managed_building\n)\n→ Hall-only complaints"]
        D2["Complaint.objects.filter(\n  category__department=profile.managed_department\n)\n→ Trade-only complaints"]
        D3["Complaint.objects.all()\nNo filter — global scope\nAll campus complaints"]
        D4["ALL models unrestricted\nUser management\nAudit override"]
    end

    subgraph DB["Database — SQLite / core tables"]
        DB1[("core_complaint\ncore_complaintstatushistory\ncore_userprofile\ncore_building\ncore_department")]
    end

